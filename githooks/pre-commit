#!/usr/bin/env bash
# Pre-commit hook: optional fast-fail for the config consistency checks and
# for LLM_CONFIG_GUIDE.md staleness.
#
# The AUTHORITATIVE check is the GitHub Actions workflow at
# .github/workflows/guide-sync.yml, which runs server-side on every
# push and PR and blocks merging if templates and the guide are out of
# sync. This local hook duplicates the logic so developers get the
# same feedback at commit time instead of waiting for CI. It is
# opt-in per clone.
#
# Rules (matching the CI workflows):
#   0. If a config, autofocus/imageprocessing file, _MM2/ or resources/ file
#      or the checks themselves are staged, run checks/config_checks.py (the
#      'Config consistency checks' workflow). Errors FAIL the commit -- e.g. a
#      setting changed in config_LCPolScope_Hamamatsu.yml but not in
#      config_LCPolScope.yml. Without Python + PyYAML it warns and lets the
#      commit through (CI still runs the check).
#   1. If anything under templates/ is modified, LLM_CONFIG_GUIDE.md
#      must also be touched in the same commit. FAILS the commit.
#   2. If config_OWS3.yml, config_PPM.yml, or autofocus_*.yml (real
#      configs, not templates) is modified, print a reminder. Warning
#      only, does not fail the commit.
#
# Install (opt-in, per clone):
#   git config core.hooksPath githooks
#
# Bypass one commit (CI will still catch it):
#   git commit --no-verify

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
NC='\033[0m'

# Files staged for this commit (added/modified/renamed, not deleted).
staged() {
    git diff --cached --name-only --diff-filter=AMR
}

STAGED=$(staged)

template_touched=0
guide_touched=0
real_config_touched=0

while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
        templates/*.yml|templates/*.yaml)
            template_touched=1
            ;;
        LLM_CONFIG_GUIDE.md)
            guide_touched=1
            ;;
        config_OWS3.yml|config_PPM.yml|config_CAMM.yml|autofocus_OWS3.yml|autofocus_PPM.yml|autofocus_CAMM.yml)
            real_config_touched=1
            ;;
    esac
done <<< "$STAGED"

exit_code=0

# --- Rule 0: config consistency checks ---------------------------------------
checks_relevant=0
while IFS= read -r f; do
    case "$f" in
        *.yml|*.yaml|_MM2/*|resources/*|checks/*) checks_relevant=1 ;;
    esac
done <<< "$STAGED"

if [ "$checks_relevant" = "1" ]; then
    # GitHub Desktop and Git Bash on Windows often have 'python' or 'py', not 'python3'.
    PY=""
    for cand in python3 python py; do
        if command -v "$cand" >/dev/null 2>&1 && "$cand" -c "import yaml" >/dev/null 2>&1; then
            PY="$cand"
            break
        fi
    done
    repo_root=$(git rev-parse --show-toplevel)
    if [ -z "$PY" ]; then
        echo -e "${YELLOW}[pre-commit] Config consistency checks skipped: no Python with PyYAML found.${NC}"
        echo "  CI runs them on push. To run them here: pip install pyyaml"
        echo ""
    elif ! report=$("$PY" "$repo_root/checks/config_checks.py" 2>&1); then
        echo -e "${RED}[pre-commit] Config consistency checks failed${NC}"
        echo ""
        echo "$report" | grep -E '^\[ERROR\]|error\(s\)' | sed 's/^/  /'
        echo ""
        echo "Usually a setting changed in one of a pair of sibling files (the LC-PolScope"
        echo "Oryx and Hamamatsu configs, or their autofocus files) and not in the other."
        echo "Copy the change to the other file, or, if that setting really belongs to one"
        echo "camera, add it to the allowed list in checks/config_checks.py."
        echo "Full report: python checks/config_checks.py"
        echo ""
        exit_code=1
    fi
fi

if [ "$template_touched" = "1" ] && [ "$guide_touched" = "0" ]; then
    echo -e "${RED}[pre-commit] Template files were modified without updating LLM_CONFIG_GUIDE.md${NC}"
    echo ""
    echo "Modified templates:"
    staged | grep -E '^templates/.*\.ya?ml$' | sed 's/^/  /'
    echo ""
    echo "LLM_CONFIG_GUIDE.md is the primary reference for new scopes and"
    echo "LLMs authoring config files from scratch. When templates change,"
    echo "the guide must be updated to match so downstream users don't"
    echo "follow stale examples."
    echo ""
    echo "Fix:"
    echo "  1. Update LLM_CONFIG_GUIDE.md to reflect the template changes"
    echo "  2. git add LLM_CONFIG_GUIDE.md"
    echo "  3. Re-run the commit"
    echo ""
    echo "Bypass (not recommended):"
    echo "  git commit --no-verify"
    echo ""
    exit_code=1
fi

if [ "$real_config_touched" = "1" ] && [ "$guide_touched" = "0" ]; then
    echo -e "${YELLOW}[pre-commit] Warning: real scope configs changed without a LLM_CONFIG_GUIDE.md update${NC}"
    echo ""
    echo "Modified real configs:"
    staged | grep -E '^(config|autofocus)_(OWS3|PPM|CAMM)\.yml$' | sed 's/^/  /'
    echo ""
    echo "The guide's worked examples reference config_OWS3.yml. If the"
    echo "change you just staged adds a new schema pattern (not just a"
    echo "hardware value tweak), consider updating the guide too."
    echo ""
    echo "Not failing the commit -- this is a reminder, not a gate."
    echo ""
fi

if [ "$exit_code" = "0" ] && [ "$template_touched" = "1" ] && [ "$guide_touched" = "1" ]; then
    echo -e "${GREEN}[pre-commit] Template + LLM_CONFIG_GUIDE.md both staged. OK.${NC}"
fi

exit "$exit_code"
